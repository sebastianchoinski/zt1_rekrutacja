generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Calculation {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now())
  orderItem     String
  orderQuantity Float
  materialCount Int
  input         Json
  result        Json

  @@index([createdAt])
}
